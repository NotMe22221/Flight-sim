{
  "name": "flight-sim",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based flight simulator in the spirit of Microsoft Flight Simulator: realistic 6-DOF flight dynamics, real-world terrain, physically based sky and weather, glass and steam cockpits.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fast-png": "8.0.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
